{
  "name": "chiptable",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "esbuild src/engine/engine.ts --bundle --format=esm --outfile=tests/engine.build.mjs --log-level=error && node --test tests/engine.test.mjs",
    "build:pages": "tsc -b && vite build && node scripts/make-404.mjs",
    "bundle:function": "esbuild supabase/functions/game/index.ts --bundle --format=esm --target=esnext --outfile=supabase/functions/game/bundled.ts --log-level=error && node scripts/stamp-bundle.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
